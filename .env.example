# Sanity — safe to expose, these ship in the client bundle
PUBLIC_SANITY_PROJECT_ID=8a5r7mk5
PUBLIC_SANITY_DATASET=production

# Resend — SERVER ONLY. No PUBLIC_ prefix, so Astro keeps it out of the bundle.
# Read by src/pages/api/contact.ts. Set this in Netlify's env settings too.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=hello@boxandpixel.com

# Verified Resend sender. Until the domain is verified in Resend,
# onboarding@resend.dev works for testing.
CONTACT_FROM_EMAIL=onboarding@resend.dev
