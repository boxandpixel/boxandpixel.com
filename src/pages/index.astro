---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
// import WorkCards from "../components/WorkCards.astro";
import ServiceCallout from "../components/ServiceCallout.astro";
---

<Layout
  title="Box + Pixel — Boutique web development studio"
  description="A boutique web studio that builds, launches, and looks after WordPress, Next.js, and Astro sites, with agentic AI workflows and a human at the helm."
>
  <Hero
    size="display"
    align="center"
    stage="horizon"
    headline="Building websites that perform."
    highlight="perform"
    subheading="Box + Pixel builds, launches, and keeps your site secure, fast, and growing for the long term."
  />

  {/* Band sequence: surface → feature CTA.
      `feature` needs a `surface` predecessor or the CTA card merges into the
      band above, so whichever band sits just before it takes the surface
      fill. Cards take the opposite fill of the band they sit in (Section
      sets --card-fill).

      Selected work is parked until case studies are approved. To restore it,
      uncomment the block below, uncomment the WorkCards import, and set the
      About band back to the default variant (Selected work takes surface).
      It has no "All work" link until /work is built. */}
  <Section
    eyebrow="About"
    title="An independent studio, since 2011"
    intro="Box + Pixel is led by Brian Gunzenhauser, a technical strategist, educator, and senior developer working on the web since 2003. Every project starts from your goals, and every decision is measured against them."
    cta={{ href: "/about", label: "More about Box + Pixel" }}
    variant="surface"
  />

  {/*
  <Section
    eyebrow="Selected work"
    title="Sites in Box + Pixel's care"
    variant="surface"
  >
    <WorkCards
      items={[
        {
          client: "Summers & Zim's",
          title: "Design, development, and proactive management for a home services company",
          summary: "With no outside designer involved, the designs were shaped directly with the client, then built, tested, and kept fast and secure. The relationship predates the studio: Brian has worked with them since 2008.",
          stat: "18+ years",
          href: "https://sumzim.com",
        },
        {
          client: "Northern Virginia Magazine",
          title: "Technical strategy and development for a regional magazine",
          summary: "A custom directory, Google News and Discover visibility, and the Best of NoVA Soiree and Taste of NoVA microsites. Box + Pixel developed the magazine's 2020 redesign, then was hired again for the 2026 one.",
          stat: "6+ years",
          href: "https://northernvirginiamag.com",
        },
        {
          client: "One Story",
          title: "E-commerce development for a literary magazine",
          summary: [
            "Designed by ",
            { text: "Iris A. Brown Design", href: "https://iabdny.com/" },
            ", built by Box + Pixel. A custom WooCommerce migration for subscriptions, gifting, and memberships, and a steady run of new features since launch.",
          ],
          stat: "4+ years",
          href: "https://one-story.com",
        },
      ]}
    />
  </Section>
  */}

  <ServiceCallout
    eyebrow="Get in touch"
    title="What's next for your site?"
    variant="feature"
    cta={{ href: "/contact", label: "Start a conversation" }}
  >
    <p>
      Send over what you're working on. You'll get an honest answer on whether
      it's a good fit and what it would take.
    </p>
  </ServiceCallout>
</Layout>
